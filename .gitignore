# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 本地笔记 / 工作产物 (不入 git)
/.workbuddy/

# editor-local project state (not application source)
/.idea/

# generated release archives and staging directories
/outputs/
/.release-stage/
/.release-smoke/

# CMS vendor is built and verified by CI, never committed.
/public/admin/vendor/

# Local CMS preview and test-repository administration only.
# Keep test-cms-image-converter.mjs and test-cms-patch.mjs: release CI runs them.
/scripts/build-cms-preview.mjs
/scripts/prepare-cms-test.mjs
/scripts/serve-cms-test.mjs
/scripts/unify-cms-test.mjs
/scripts/install-cms-lifecycle-test.mjs
/scripts/install-cms-maintain-test.mjs
/scripts/cms-maintain-test.mjs
/scripts/cms-validate-content-test.mjs
/scripts/test-cms-branch-lifecycle.mjs
/scripts/test-cms-maintenance-guards.mjs

# local runtime and diagnostic output
/logs/
/pnpm-store/
/.pnpm-store/
/_syncheck_result.txt

# Windows filesystem metadata
Thumbs.db
Desktop.ini

# 本地 Caddy 密钥 (basic auth 密码哈希, 服务器本地维护)
/secrets.caddy

# AI 助手 / 编码 agent 的项目说明文档 (工具链配置, 不是项目源代码)
# 跟踪到仓库会被 agent 反复编辑产生噪音, 也容易泄漏 prompt 上下文
AGENTS.md
CLAUDE.md

# scripts/ 里 build/push 流程不用的 dev 工具 (一次性内容生成 / 调试脚本)
# 保留 (不被忽略) 的 5 个是 build/push 必需的:
#   package-release.mjs / test-release.mjs / copy-release-tree.mjs
#   include-runtime-package.mjs / convert-news-images.mjs
# 新增 dev 脚本默认入版本控制; 加到这里 = 后续新增文件不入 git, 已 tracked 不动
/scripts/build-thumbs-fine-sprite.mjs
/scripts/convert-icons-to-webp.mjs
/scripts/convert-overworld-to-webp.mjs
/scripts/gen-image-webps.cjs
/scripts/gen-overworld-thumbs.cjs
/scripts/gen-test-images.cjs
/scripts/gen-test-tiles.cjs
/scripts/inspect-overworld-tiles.cjs
/scripts/migrate-data-png-to-webp.cjs
/scripts/png-to-webp-q95.cjs
/scripts/rebuild-images-from-origin.mjs
/scripts/relayout-overworld-tiles.cjs
/scripts/verify-search.mjs

# 本地 agent / 调试产物 (一次性脚本输出, 不是项目源代码)
# .clean.js            — 测试 helper, 触发 stripDuplicates 修复时用过
# .test-compress.ps1   — zstd/xz 对比压缩格式时写的临时 PowerShell
# stderr.log           — 各种本地 build/package 测试时 node 的 stderr 泄漏
/.clean.js
/.test-compress.ps1
/stderr.log
