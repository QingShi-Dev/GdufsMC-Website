# =============================================================================
# Caddyfile — gdufsmc 反代 + 自动 HTTPS
# =============================================================================
# 替代 deploy/nginx.conf.template + deploy/nginx-security.conf
# Caddy 自动从 Let's Encrypt 申请 + 续期 HTTPS 证书, 无需 certbot
# 安全头在 next.config.ts 已设, 这里补 Caddy 层冗余头 (避免 next.js 配置被覆盖)
#
# 部署: caddy run --config Caddyfile
#      或 `nssm` 装成 Windows 服务
#
# !! 密码 / 密钥不在此文件 !!
#   - /admin/* 的 basicauth 密码哈希在 ./secrets.caddy (本地维护, .gitignore)
#   - 首次部署从 ./secrets.caddy.example 复制并填入真实 bcrypt 哈希
#   - secrets.caddy 在 site block 内 import, 引用外层 @adminPath matcher
# =============================================================================

{
    # 全局: 禁 admin API, 自动 HTTPS (默认就是自动, 不需要写 on)
    #   auto_https 合法值: off | disable_redirects | disable_certs | ignore_loaded_certs
    #   默认行为 = 自动签证书 + HTTP→HTTPS 重定向, 这正是我们要的
    admin off
    email admin@gdufscraft.top  # Let's Encrypt 证书到期通知邮箱
}

# -----------------------------------------------------------------------------
# www → 主域重定向 (避免重复内容 SEO 惩罚)
# -----------------------------------------------------------------------------
www.gdufscraft.top {
    redir https://gdufscraft.top{uri} permanent
}

# -----------------------------------------------------------------------------
# 主域
# -----------------------------------------------------------------------------
gdufscraft.top {
    # favicon 直接由 Next.js (端口 3000) 处理, 不在 Caddy 这层静态服务
    #   Next.js App Router 会在 HTML 里输出 <link rel="icon" href="/favicon.ico?favicon=<hash>.ico">,
    #   standalone 构建自带 /favicon.ico 路由 + hash 版本路由, 都由 Node 处理
    #   避免把 favicon 物理路径写在 Caddyfile 里 (跨 release 不稳定, 也跟容器化冲突)

    # /images/* 静态资源直接由 Caddy 服务, 不走 Next.js
    #   E2 架构: public/images/ 不进 release, 维护在 H:\GDUFSMC-web\public\images\
    #   Caddy file_server 直接吐, 比过 Node 快 10x
    #   新增图片需要手动同步到 H:\GDUFSMC-web\public\images\ (或扩展 publish-release.ps1 加 sync 步骤)
    #   Cache-Control: max-age=60 浏览器短缓存 (改图后 1 分钟内刷新能看到)
    #     不设 s-maxage → EdgeOne 按默认规则 (通常继承 max-age 或按站点 cache rule)
    @publicImages path /images/*
    handle @publicImages {
        root * H:\GDUFSMC-web\public
        file_server
        header Cache-Control "public, max-age=60"
    }

    # /download/* 公开下载目录, 直接由 Caddy 服务, 不走 Next.js
    #   目录: H:\GDUFSMC-web\download\ (跟 public\images 一样是部署根下的
    #   共享目录, 不进 release; 新增文件不需要重新发布)
    #   用法: 把文件丢进去, 链接就是 https://gdufscraft.top/download/<文件名>
    #         例如 H:\GDUFSMC-web\download\map.zip -> /download/map.zip
    #   handle_path (不是 handle) 会把 /download 前缀从路径里剥掉, 因此
    #     root 指向 download 目录本身, 服务范围被限制在这一个目录内 ——
    #     部署根下还有 secrets.caddy / secrets.edgeone.json / shared\*.json
    #     这些带凭据的文件, 不该被路径技巧碰到。
    #   不开 browse: 目录请求返回 404, 只能按精确文件名访问, 没有列表页
    #   Content-Disposition: attachment 强制浏览器下载而不是 inline 渲染
    #     (.txt/.json/.md 默认会被浏览器直接显示出来)。刻意不带 filename=
    #     参数 —— 浏览器改从 URL 推断文件名并自行解码 percent-encoding,
    #     这样中文名不需要 RFC 6266 的 filename*=UTF-8'' 编码。
    #   换文件用同一个链接时, 浏览器本地缓存 5 分钟内会拿到旧文件;
    #     EdgeOne 是否缓存这份响应取决于站点侧的 cache rule, 换大文件建议
    #     改文件名 (带版本号) 而不是覆盖同名文件。
    handle_path /download/* {
        root * H:\GDUFSMC-web\download
        file_server
        header Content-Disposition "attachment"
        header Cache-Control "public, max-age=300"
    }

    # /admin/* 需要 basic auth — 密码哈希从 ./secrets.caddy 导入
    #   secrets.caddy 在 .gitignore, 服务器本地维护, 部署时不会从 git 同步进来
    #   首次部署: Copy-Item secrets.caddy.example secrets.caddy + 填入真密码哈希
    @adminPath path /admin /admin/* /api/admin /api/admin/*
    import secrets.caddy

    # 反代到 PM2 启动的 Next.js (端口 3000)
    #   X-Forwarded-* 透传真实客户端 IP (proxy.ts 用 XFF 最右)
    handle {
        reverse_proxy 127.0.0.1:3000 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 安全头冗余 (next.config.ts 也设了, 这里防 next.js 配置被覆盖)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    }

    # 压缩响应
    encode zstd gzip

    # 访问日志 (单独文件, 方便 logrotate / 备份)
    log {
        output file H:\GDUFSMC-web\logs\caddy-access.log {
            roll_size 10MiB
            roll_keep 5
        }
    }
}